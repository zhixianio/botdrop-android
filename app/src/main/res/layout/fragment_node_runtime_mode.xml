<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- Node Status Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/status_indicator"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/status_indicator_stopped" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/botdrop_node_stopped"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/botdrop_on_background" />
        </LinearLayout>

        <TextView
            android:id="@+id/uptime_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="—"
            android:textSize="14sp"
            android:textColor="@color/botdrop_secondary_text" />

        <TextView
            android:id="@+id/node_gateway_info_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/botdrop_node_gateway_connection_title"
            android:textColor="@color/botdrop_secondary_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/node_gateway_host_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/botdrop_on_background"
            android:textSize="13sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/node_gateway_port_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/botdrop_on_background"
            android:textSize="13sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/node_gateway_tls_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/botdrop_on_background"
            android:textSize="13sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/node_gateway_token_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/botdrop_on_background"
            android:textSize="13sp"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/btn_edit_node_gateway_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/botdrop_node_gateway_edit"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:background="@drawable/botdrop_button_outline_bg"
            android:textColor="@color/botdrop_accent"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:minHeight="0dp" />

        <TextView
            android:id="@+id/openclaw_version_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp"
            android:textSize="13sp"
            android:textColor="@color/botdrop_secondary_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_open_openclaw_web_ui"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:textAllCaps="false"
                android:text="@string/botdrop_open_web_ui"
                android:textSize="12sp"
                android:background="@drawable/botdrop_button_outline_bg"
                android:textColor="@color/botdrop_accent"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:minHeight="0dp" />

            <Button
                android:id="@+id/btn_view_openclaw_log"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:textAllCaps="false"
                android:text="@string/botdrop_view_log"
                android:textSize="12sp"
                android:background="@drawable/botdrop_button_outline_bg"
                android:textColor="@color/botdrop_accent"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:minHeight="0dp" />

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
